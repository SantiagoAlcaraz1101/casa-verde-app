generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  points    Int      @default(0)
  actions   EcoAction[]
  redemptions Redemption[]
  createdAt DateTime @default(now())
}

model WasteItem {
  id          String @id @default(uuid())
  name        String
  category    String
  description String
}

model EcoAction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Tip {
  id      String @id @default(uuid())
  content String
}

model EcoActionConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reward {
  id          String       @id @default(uuid())
  name        String
  description String
  pointsCost  Int
  stock       Int
  isActive    Boolean      @default(true)
  redemptions Redemption[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Redemption {
  id        String   @id @default(uuid())
  userId    String
  rewardId  String
  pointsUsed Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])
}